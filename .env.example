APP_NAME=AfriTopup
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/AFRITOPUP/public
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=afritopup
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Instant notifications. Set to "reverb", fill the REVERB_* keys and run
# `php artisan reverb:start`. Left as "log", everything still works by polling.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@afritopup.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AfriTopup (config/afritopup.php) ─────────────────────────────────
# White-label: change these to run the platform under another brand.
AFRITOPUP_NAME=AfriTopup
AFRITOPUP_COMPANY=AfriTopup
AFRITOPUP_TAGLINE="Your One-Stop Digital Payment and Recharge Platform."
AFRITOPUP_WEBSITE=https://afritopup.com
AFRITOPUP_SUPPORT_EMAIL=support@afritopup.com
AFRITOPUP_SUPPORT_PHONE=
AFRITOPUP_ADDRESS=
AFRITOPUP_PRIMARY_COLOR=#0B8457
AFRITOPUP_ACCENT_COLOR=#F5A623
AFRITOPUP_ALLOW_REGISTRATION=true
AFRITOPUP_DEFAULT_COUNTRY=NG
AFRITOPUP_DEFAULT_CURRENCY=NGN

# Credit shown in the footer and the app.
AFRITOPUP_DEVELOPER="Qudroid Systems"
AFRITOPUP_DEVELOPER_URL=https://qudroids.com

# ── Sign in with Google / Apple ──
# Google Cloud → APIs & Services → Credentials: create OAuth client IDs (Web, Android, iOS).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Every client ID whose tokens are accepted (web, android, ios), comma-separated.
GOOGLE_CLIENT_IDS=
# Apple: the app bundle ID, plus the Services ID for the website, comma-separated.
APPLE_CLIENT_IDS=com.afritopup.app
APPLE_SERVICES_ID=

# The first administrator (php artisan db:seed). Must change the password at first sign-in.
AFRITOPUP_ADMIN_NAME="Super Administrator"
AFRITOPUP_ADMIN_EMAIL=admin@afritopup.com
AFRITOPUP_ADMIN_PASSWORD=ChangeMe@123

# Provider new services are seeded with: sandbox (no real purchases) or vtpass.
AFRITOPUP_SEED_PROVIDER=sandbox

# Wallet funding limits and the Paystack fee passed to the customer.
AFRITOPUP_FUND_MIN=100
AFRITOPUP_FUND_MAX=1000000
AFRITOPUP_FUND_FEE_PERCENT=1.5
AFRITOPUP_FUND_FEE_FLAT=0
AFRITOPUP_FUND_FEE_CAP=2000

# ── Paystack (wallet funding) — or set in Settings → Payment gateways ──
# Webhook URL for the Paystack dashboard: https://<your-domain>/webhook/paystack
PAYSTACK_ACTIVE=true
PAYSTACK_MODE=sandbox
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=

# ── VTpass (airtime, data, cable, electricity, exam PINs) — or Settings → Providers ──
VTPASS_MODE=sandbox
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# ── Termii (bulk SMS) — or Settings → Providers ──
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=AfriTopup
TERMII_CHANNEL=generic

# ── Push notifications to the mobile app (Firebase) ──
FCM_ENABLED=false
FCM_PROJECT_ID=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
